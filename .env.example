# Runtime data stays outside the source tree in production.
CATCHBOX_DATA_DIR=/var/lib/catchbox

# Used only to create the single local account when `bun run auth:bootstrap` runs.
CATCHBOX_BOOTSTRAP_USERNAME=operator
CATCHBOX_BOOTSTRAP_PASSWORD=replace-with-a-long-random-passphrase

# HTTP listener. Keep the default host on a trusted LAN or bind to 127.0.0.1.
CATCHBOX_HOST=0.0.0.0
CATCHBOX_PORT=3000

# Session lifetimes in seconds.
CATCHBOX_SESSION_IDLE_SECONDS=604800
CATCHBOX_SESSION_ABSOLUTE_SECONDS=2592000

# Enable only when browsers reach Catchbox over HTTPS.
CATCHBOX_SECURE_COOKIES=false

# Controls framework optimizations and log formatting.
NODE_ENV=production
